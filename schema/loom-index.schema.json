{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/lucasp1337/laravel-loom/schema/loom-index.schema.json",
    "title": "Laravel Loom Index",
    "description": "Canonical schema for the JSON index emitted by `php artisan loom:scan`.",
    "type": "object",
    "required": [
        "loom_version",
        "scanned_at",
        "laravel_version",
        "stats",
        "events",
        "model_events",
        "listeners",
        "observers",
        "jobs",
        "unresolved_dispatches",
        "closure_listeners",
        "scheduled",
        "routes",
        "mailables",
        "notifications"
    ],
    "additionalProperties": false,
    "properties": {
        "loom_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+" },
        "scanned_at": { "type": "string", "format": "date-time" },
        "laravel_version": { "type": "string" },
        "stats": {
            "type": "object",
            "required": ["events", "listeners", "observers", "jobs", "unresolved_dispatches", "closure_listeners", "scheduled", "routes", "mailables", "notifications"],
            "additionalProperties": false,
            "properties": {
                "events": { "type": "integer", "minimum": 0 },
                "listeners": { "type": "integer", "minimum": 0 },
                "observers": { "type": "integer", "minimum": 0 },
                "jobs": { "type": "integer", "minimum": 0 },
                "unresolved_dispatches": { "type": "integer", "minimum": 0 },
                "closure_listeners": { "type": "integer", "minimum": 0 },
                "scheduled": { "type": "integer", "minimum": 0 },
                "routes": { "type": "integer", "minimum": 0 },
                "mailables": { "type": "integer", "minimum": 0 },
                "notifications": { "type": "integer", "minimum": 0 }
            }
        },
        "events": {
            "type": "array",
            "items": { "$ref": "#/$defs/event" }
        },
        "model_events": {
            "type": "array",
            "items": { "$ref": "#/$defs/modelEvent" }
        },
        "listeners": {
            "type": "array",
            "items": { "$ref": "#/$defs/listener" }
        },
        "observers": {
            "type": "array",
            "items": { "$ref": "#/$defs/observer" }
        },
        "jobs": {
            "type": "array",
            "items": { "$ref": "#/$defs/job" }
        },
        "unresolved_dispatches": {
            "type": "array",
            "items": { "$ref": "#/$defs/unresolvedDispatch" }
        },
        "closure_listeners": {
            "type": "array",
            "items": { "$ref": "#/$defs/closureListener" }
        },
        "scheduled": {
            "type": "array",
            "items": { "$ref": "#/$defs/scheduleEntry" }
        },
        "routes": {
            "type": "array",
            "items": { "$ref": "#/$defs/route" }
        },
        "mailables": {
            "type": "array",
            "items": { "$ref": "#/$defs/mailable" }
        },
        "notifications": {
            "type": "array",
            "items": { "$ref": "#/$defs/notification" }
        }
    },
    "$defs": {
        "event": {
            "type": "object",
            "required": ["id", "fqcn", "kind", "file", "line", "dispatched_from", "handled_by"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string" },
                "fqcn": { "type": "string" },
                "kind": { "enum": ["class"] },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "dispatched_from": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatchSite" }
                },
                "handled_by": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["listener", "method"],
                        "additionalProperties": false,
                        "properties": {
                            "listener": { "type": "string" },
                            "method": { "type": "string" }
                        }
                    }
                }
            }
        },
        "modelEvent": {
            "type": "object",
            "required": ["id", "kind", "model", "event", "handled_by"],
            "additionalProperties": false,
            "properties": {
                "id": { "type": "string" },
                "kind": { "enum": ["model_event"] },
                "model": { "type": "string" },
                "event": {
                    "enum": [
                        "retrieved", "creating", "created", "updating", "updated",
                        "saving", "saved", "deleting", "deleted", "restoring", "restored",
                        "replicating", "trashed", "forceDeleting", "forceDeleted",
                        "booting", "booted"
                    ]
                },
                "handled_by": {
                    "type": "array",
                    "items": { "type": "string" }
                }
            }
        },
        "listener": {
            "type": "object",
            "required": ["fqcn", "file", "line", "handles", "registration", "queued", "dispatches"],
            "additionalProperties": false,
            "properties": {
                "fqcn": { "type": "string" },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "handles": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["event", "method"],
                        "additionalProperties": false,
                        "properties": {
                            "event": { "type": "string" },
                            "method": { "type": "string" }
                        }
                    }
                },
                "registration": {
                    "enum": ["listen_array", "auto_discovered", "event_listen_call", "subscriber"]
                },
                "queued": { "type": "boolean" },
                "dispatches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatch" }
                }
            }
        },
        "observer": {
            "type": "object",
            "required": ["fqcn", "file", "line", "observes", "registration", "hooks", "dispatches"],
            "additionalProperties": false,
            "properties": {
                "fqcn": { "type": "string" },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "observes": { "type": "string" },
                "registration": { "enum": ["observe_call", "attribute"] },
                "hooks": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "dispatches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatch" }
                }
            }
        },
        "job": {
            "type": "object",
            "required": ["fqcn", "file", "line", "queued", "queue_config", "dispatched_from", "dispatches"],
            "additionalProperties": false,
            "properties": {
                "fqcn": { "type": "string" },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "queued": { "type": "boolean" },
                "queue_config": {
                    "oneOf": [
                        { "type": "null" },
                        { "$ref": "#/$defs/queueConfig" }
                    ]
                },
                "dispatched_from": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatchSite" }
                },
                "dispatches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatch" }
                }
            }
        },
        "queueConfig": {
            "type": "object",
            "required": ["connection", "queue", "delay", "tries", "timeout", "backoff"],
            "additionalProperties": false,
            "properties": {
                "connection": { "type": ["string", "integer", "null"] },
                "queue": { "type": ["string", "integer", "null"] },
                "delay": { "type": ["string", "integer", "null"] },
                "tries": { "type": ["string", "integer", "null"] },
                "timeout": { "type": ["string", "integer", "null"] },
                "backoff": { "type": ["string", "integer", "null"] }
            }
        },
        "dispatchSite": {
            "type": "object",
            "required": ["file", "line", "method"],
            "additionalProperties": false,
            "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "method": { "type": "string" },
                "overrides": { "$ref": "#/$defs/dispatchOverrides" },
                "channels": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" }
                }
            }
        },
        "dispatchOverrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "locale": { "type": "string" },
                "mailer": { "type": "string" },
                "connection": { "type": "string" },
                "queue": { "type": "string" },
                "delay": { "type": "integer", "minimum": 0 },
                "after_commit": { "type": "boolean" }
            }
        },
        "dispatch": {
            "type": "object",
            "required": ["target", "kind", "confidence", "file", "line"],
            "additionalProperties": false,
            "properties": {
                "target": { "type": "string" },
                "kind": { "enum": ["event", "job"] },
                "confidence": { "enum": ["high", "medium", "low"] },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 }
            }
        },
        "closureListener": {
            "type": "object",
            "required": ["event", "file", "line", "end_line", "registration", "queued", "dispatches"],
            "additionalProperties": false,
            "properties": {
                "event": { "type": "string" },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "end_line": { "type": "integer", "minimum": 1 },
                "registration": {
                    "enum": ["listen_array", "event_listen_call", "subscriber"]
                },
                "queued": { "type": "boolean" },
                "dispatches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatch" }
                }
            }
        },
        "scheduleEntry": {
            "type": "object",
            "required": [
                "kind",
                "name",
                "target",
                "arguments",
                "queue",
                "connection",
                "cron",
                "timezone",
                "without_overlapping",
                "without_overlapping_expires_at",
                "on_one_server",
                "run_in_background",
                "even_in_maintenance_mode",
                "constraints",
                "file",
                "line"
            ],
            "additionalProperties": false,
            "properties": {
                "kind": { "enum": ["command", "job", "closure", "exec"] },
                "name": { "type": ["string", "null"] },
                "target": { "type": ["string", "null"] },
                "arguments": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "queue": { "type": ["string", "null"] },
                "connection": { "type": ["string", "null"] },
                "cron": { "type": ["string", "null"] },
                "timezone": { "type": ["string", "null"] },
                "without_overlapping": { "type": "boolean" },
                "without_overlapping_expires_at": { "type": ["integer", "null"] },
                "on_one_server": { "type": "boolean" },
                "run_in_background": { "type": "boolean" },
                "even_in_maintenance_mode": { "type": "boolean" },
                "constraints": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 }
            }
        },
        "route": {
            "type": "object",
            "required": [
                "method",
                "uri",
                "name",
                "controller_fqcn",
                "controller_method",
                "middleware",
                "file",
                "line",
                "dispatches"
            ],
            "additionalProperties": false,
            "properties": {
                "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "ANY"] },
                "uri": { "type": "string" },
                "name": { "type": ["string", "null"] },
                "controller_fqcn": { "type": ["string", "null"] },
                "controller_method": { "type": ["string", "null"] },
                "middleware": { "type": "array", "items": { "type": "string" } },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "dispatches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatch" }
                }
            }
        },
        "mailable": {
            "type": "object",
            "required": ["fqcn", "file", "line", "queued", "queue_config", "sent_from"],
            "additionalProperties": false,
            "properties": {
                "fqcn": { "type": "string" },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "queued": { "type": "boolean" },
                "queue_config": {
                    "oneOf": [
                        { "type": "null" },
                        { "$ref": "#/$defs/queueConfig" }
                    ]
                },
                "sent_from": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatchSite" }
                }
            }
        },
        "notification": {
            "type": "object",
            "required": ["fqcn", "file", "line", "queued", "queue_config", "notified_from", "channels", "channels_dynamic"],
            "additionalProperties": false,
            "properties": {
                "fqcn": { "type": "string" },
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "queued": { "type": "boolean" },
                "queue_config": {
                    "oneOf": [
                        { "type": "null" },
                        { "$ref": "#/$defs/queueConfig" }
                    ]
                },
                "notified_from": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatchSite" }
                },
                "channels": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "channels_dynamic": { "type": "boolean" }
            }
        },
        "unresolvedDispatch": {
            "type": "object",
            "required": ["file", "line", "expression", "reason"],
            "additionalProperties": false,
            "properties": {
                "file": { "type": "string" },
                "line": { "type": "integer", "minimum": 1 },
                "expression": { "type": "string" },
                "reason": {
                    "enum": [
                        "dynamic_class_name",
                        "container_resolution",
                        "string_concatenation",
                        "conditional_dispatch"
                    ]
                }
            }
        }
    }
}
