{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/lucasp1337/laravel-loom/schema/loom-index.schema.json",
    "title": "Laravel Loom Index",
    "description": "Canonical schema for the JSON index emitted by `php artisan loom:scan`.",
    "type": "object",
    "required": [
        "schema_version",
        "loom_version",
        "scanned_at",
        "laravel_version",
        "stats",
        "events",
        "model_events",
        "listeners",
        "observers",
        "jobs",
        "unresolved_dispatches",
        "closure_listeners",
        "scheduled_tasks",
        "routes",
        "mailables",
        "notifications"
    ],
    "additionalProperties": false,
    "properties": {
        "schema_version": {
            "type": "string",
            "pattern": "^1\\.[0-9]+$",
            "description": "Version of this document shape, `MAJOR.MINOR`. Consumers key on this."
        },
        "loom_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+",
            "description": "Semver of the Loom package that wrote the file. Informational."
        },
        "scanned_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$",
            "description": "ISO 8601 UTC timestamp ending in `Z`. The only field that differs between two scans of identical source."
        },
        "laravel_version": {
            "type": "string",
            "description": "Laravel version detected in the scanned app."
        },
        "stats": {
            "type": "object",
            "required": [
                "events",
                "model_events",
                "listeners",
                "observers",
                "jobs",
                "unresolved_dispatches",
                "closure_listeners",
                "scheduled_tasks",
                "routes",
                "mailables",
                "notifications"
            ],
            "additionalProperties": false,
            "properties": {
                "events": { "type": "integer", "minimum": 0 },
                "model_events": { "type": "integer", "minimum": 0 },
                "listeners": { "type": "integer", "minimum": 0 },
                "observers": { "type": "integer", "minimum": 0 },
                "jobs": { "type": "integer", "minimum": 0 },
                "unresolved_dispatches": { "type": "integer", "minimum": 0 },
                "closure_listeners": { "type": "integer", "minimum": 0 },
                "scheduled_tasks": { "type": "integer", "minimum": 0 },
                "routes": { "type": "integer", "minimum": 0 },
                "mailables": { "type": "integer", "minimum": 0 },
                "notifications": { "type": "integer", "minimum": 0 }
            },
            "description": "One integer count per section, keyed by section name; always mirrors the array sizes."
        },
        "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
        "model_events": { "type": "array", "items": { "$ref": "#/$defs/modelEvent" } },
        "listeners": { "type": "array", "items": { "$ref": "#/$defs/listener" } },
        "observers": { "type": "array", "items": { "$ref": "#/$defs/observer" } },
        "jobs": { "type": "array", "items": { "$ref": "#/$defs/job" } },
        "unresolved_dispatches": { "type": "array", "items": { "$ref": "#/$defs/unresolvedDispatch" } },
        "closure_listeners": { "type": "array", "items": { "$ref": "#/$defs/closureListener" } },
        "scheduled_tasks": { "type": "array", "items": { "$ref": "#/$defs/scheduleEntry" } },
        "routes": { "type": "array", "items": { "$ref": "#/$defs/route" } },
        "mailables": { "type": "array", "items": { "$ref": "#/$defs/mailable" } },
        "notifications": { "type": "array", "items": { "$ref": "#/$defs/notification" } }
    },
    "$defs": {
        "relativePath": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![/\\\\]|[A-Za-z]:)",
            "description": "Path relative to the app root, forward-slashed. Never absolute: a leading `/`, `\\` or drive letter is rejected."
        },
        "event": {
            "type": "object",
            "required": ["id", "fqcn", "kind", "file", "line", "dispatched_from", "handled_by"],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Canonical identifier; the FQCN for class events."
                },
                "fqcn": {
                    "type": "string",
                    "description": "Fully qualified class name."
                },
                "kind": {
                    "enum": ["class"],
                    "description": "Only `class` today."
                },
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File declaring the class."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed declaration line."
                },
                "dispatched_from": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatchSite" },
                    "description": "Dispatch sites that fire this event."
                },
                "handled_by": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["listener", "method"],
                        "additionalProperties": false,
                        "properties": {
                            "listener": {
                                "type": "string",
                                "description": "Listener FQCN."
                            },
                            "method": {
                                "type": "string",
                                "description": "Handler method on the listener."
                            }
                        }
                    },
                    "description": "Listeners that handle this event, one entry per listener and method, sorted by `listener`, `method`. Taken from `listeners[].handles`; closure listeners are not included."
                }
            },
            "description": "Event classes."
        },
        "modelEvent": {
            "type": "object",
            "required": ["id", "kind", "model", "event", "handled_by"],
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string",
                    "description": "`eloquent.{event}: {model FQCN}`."
                },
                "kind": {
                    "enum": ["model_event"],
                    "description": "Always `model_event`."
                },
                "model": {
                    "type": "string",
                    "description": "FQCN of the model."
                },
                "event": {
                    "enum": [
                        "retrieved",
                        "creating",
                        "created",
                        "updating",
                        "updated",
                        "saving",
                        "saved",
                        "deleting",
                        "deleted",
                        "restoring",
                        "restored",
                        "replicating",
                        "trashed",
                        "forceDeleting",
                        "forceDeleted",
                        "booting",
                        "booted"
                    ],
                    "description": "Eloquent hook name. `booting` and `booted` come only from `Event::listen('eloquent.booted: ...')` strings; observer methods match the other values."
                },
                "handled_by": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["handler", "method", "file", "line"],
                        "additionalProperties": false,
                        "properties": {
                            "handler": {
                                "type": "string",
                                "description": "FQCN of the observer, `Event::listen` target or hook callback class. For a closure model hook, the model FQCN."
                            },
                            "method": {
                                "type": "string",
                                "description": "Observer hook or listener method. `{closure}` for a closure model hook; its body is the `closure_listeners[]` entry at the same file and line."
                            },
                            "file": {
                                "$ref": "#/$defs/relativePath",
                                "description": "Observer class file, or the file holding the `Event::listen` call or model hook registration."
                            },
                            "line": {
                                "type": "integer",
                                "minimum": 1,
                                "description": "Observer class line, or the `Event::listen` call line."
                            }
                        }
                    },
                    "description": "Observers and `Event::listen` targets, sorted by handler and method, deduplicated. The shape differs from `events[].handled_by` because observers are not listeners."
                }
            },
            "description": "Synthetic Eloquent model events from observer hooks and `Event::listen('eloquent.*')` strings."
        },
        "listener": {
            "type": "object",
            "required": ["fqcn", "file", "line", "handles", "registration", "queued", "dispatches"],
            "additionalProperties": false,
            "properties": {
                "fqcn": {
                    "type": "string",
                    "description": "Fully qualified class name."
                },
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File declaring the class."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed declaration line."
                },
                "handles": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["event", "method"],
                        "additionalProperties": false,
                        "properties": {
                            "event": {
                                "type": "string",
                                "description": "FQCN of the event class."
                            },
                            "method": {
                                "type": "string",
                                "description": "Handler method. `handle` when the registration names none (auto-discovery, a bare `Listener::class`); a `[Listener::class, 'foo']` tuple keeps its method."
                            }
                        }
                    },
                    "description": "Events this listener handles, deduplicated by `event`, `method` and sorted by `event`, then `method`."
                },
                "registration": {
                    "enum": ["listen_array", "auto_discovered", "discovery_unverified", "event_listen_call", "subscriber", "model_hook"],
                    "description": "`subscriber`: a subscriber's `subscribe()`.\n`listen_array`: `$listen`.\n`event_listen_call`: `Event::listen()`.\n`auto_discovered`: typed `handle()` under a discovery directory, with discovery verified on.\n`discovery_unverified`: the same, but whether the app runs event discovery could not be read.\n`model_hook`: only closure listeners carry it.\nListed in order of precedence when several find the same listener."
                },
                "queued": {
                    "type": "boolean",
                    "description": "`true` when the class implements `ShouldQueue` directly or through a parent class or interface. Traits are not followed."
                },
                "dispatches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatch" },
                    "description": "Events and jobs dispatched from the listener's handler methods."
                }
            },
            "description": "Listener classes. Handler methods include inherited ones."
        },
        "observer": {
            "type": "object",
            "required": ["fqcn", "file", "line", "observes", "registration", "hooks", "dispatches"],
            "additionalProperties": false,
            "properties": {
                "fqcn": {
                    "type": "string",
                    "description": "Fully qualified class name."
                },
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File declaring the class."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed declaration line."
                },
                "observes": {
                    "type": "string",
                    "description": "FQCN of the observed model."
                },
                "registration": {
                    "enum": ["observe_call", "attribute"],
                    "description": "`observe_call` for `Model::observe(Observer::class)`, including `static::observe()` in `booted()`; `attribute` for `#[ObservedBy]`."
                },
                "hooks": {
                    "type": "array",
                    "items": {
                        "enum": [
                            "retrieved",
                            "creating",
                            "created",
                            "updating",
                            "updated",
                            "saving",
                            "saved",
                            "deleting",
                            "deleted",
                            "restoring",
                            "restored",
                            "replicating",
                            "trashed",
                            "forceDeleting",
                            "forceDeleted"
                        ]
                    },
                    "description": "Observable model events the observer has a method for, sorted."
                },
                "dispatches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatch" },
                    "description": "Dispatches made from the observer's hook methods."
                }
            },
            "description": "Observer classes. One observer registered against N models gives N entries; when a pair is found through both paths, `attribute` wins over `observe_call`."
        },
        "job": {
            "type": "object",
            "required": ["fqcn", "file", "line", "queued", "queue_config", "dispatched_from", "dispatches"],
            "additionalProperties": false,
            "properties": {
                "fqcn": {
                    "type": "string",
                    "description": "Fully qualified class name."
                },
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File declaring the class."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed declaration line."
                },
                "queued": {
                    "type": "boolean",
                    "description": "`true` when the class implements `ShouldQueue` directly or through a parent class or interface. Traits are not followed."
                },
                "queue_config": {
                    "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/queueConfig" }],
                    "description": "`null` when `queued` is `false`."
                },
                "dispatched_from": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatchSite" },
                    "description": "Dispatch sites whose resolved kind is `job` and whose target is this class."
                },
                "dispatches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatch" },
                    "description": "Dispatches made from the job's `handle` method."
                }
            },
            "description": "Job classes."
        },
        "queueConfig": {
            "type": "object",
            "required": ["connection", "queue", "delay", "tries", "timeout", "backoff"],
            "additionalProperties": false,
            "properties": {
                "connection": {
                    "type": ["string", "integer", "null"],
                    "description": "Literal value of the class's `$connection` property."
                },
                "queue": {
                    "type": ["string", "integer", "null"],
                    "description": "Literal value of the class's `$queue` property."
                },
                "delay": {
                    "type": ["string", "integer", "null"],
                    "description": "Literal value of the class's `$delay` property."
                },
                "tries": {
                    "type": ["string", "integer", "null"],
                    "description": "Literal value of the class's `$tries` property."
                },
                "timeout": {
                    "type": ["string", "integer", "null"],
                    "description": "Literal value of the class's `$timeout` property."
                },
                "backoff": {
                    "type": ["string", "integer", "null"],
                    "description": "Literal value of the class's `$backoff` property."
                }
            },
            "description": "Class-level property literals. A key is `null` when the class declares no such property. The literal keeps its own type."
        },
        "dispatchSite": {
            "type": "object",
            "required": ["file", "line", "method"],
            "additionalProperties": false,
            "properties": {
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File of the dispatch site."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed line of the dispatch site."
                },
                "method": {
                    "type": "string",
                    "description": "Origin: `Class::method` (a pass-through closure such as `DB::transaction(fn () => ...)` counts for the enclosing method), `VERB /uri` for a route closure, `Class::$dispatchesEvents[hook]` for a model entry."
                },
                "mode": {
                    "enum": ["sync", "after_response", "push"],
                    "description": "How the call form executes; omitted for plain forms, whose outcome follows the target's `queued` flag. Describes the call form only: `ShouldQueue` and the sync driver are not evaluated."
                },
                "overrides": {
                    "$ref": "#/$defs/dispatchOverrides",
                    "description": "Dispatch-time modifiers found at the call site. Omitted when none."
                },
                "channels": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string" },
                    "description": "Notification-only. The literal channel filter of `Notification::send($users, $n, $channels)` or `sendNow(...)`, which overrides the notification's `via()`. Lowercased names or channel-class FQCNs. Omitted when absent, empty or non-literal."
                }
            },
            "description": "One place where a class is dispatched, sent or notified from. Shared by every `dispatched_from`, `sent_from` and `notified_from` list."
        },
        "dispatchOverrides": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "locale": {
                    "type": "string",
                    "description": "From `->locale('es')`."
                },
                "mailer": {
                    "type": "string",
                    "description": "From `->mailer('ses')`."
                },
                "connection": {
                    "type": "string",
                    "description": "From `->onConnection('redis')`."
                },
                "queue": {
                    "type": "string",
                    "description": "From `->onQueue('high')`."
                },
                "delay": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "From `->delay(60)`, integer seconds only; `now()->addMinutes(5)` and variables leave it absent."
                },
                "after_commit": {
                    "type": "boolean",
                    "description": "From `->afterCommit()`; only ever `true`."
                }
            },
            "description": "Fluent modifiers found at the call site. Only keys that were found are present; a non-literal argument leaves its key absent."
        },
        "dispatch": {
            "type": "object",
            "required": ["target", "kind", "confidence", "file", "line"],
            "additionalProperties": false,
            "properties": {
                "target": {
                    "type": "string",
                    "description": "FQCN of the dispatched event or job."
                },
                "kind": {
                    "enum": ["event", "job"],
                    "description": "Whether the target is an event or a job."
                },
                "confidence": {
                    "enum": ["high", "medium", "low"],
                    "description": "Always `high` for statically resolved targets; `medium` and `low` are reserved."
                },
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File of the dispatching call."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed line of the dispatching call."
                }
            },
            "description": "A resolved dispatch made from a class method or closure."
        },
        "closureListener": {
            "type": "object",
            "required": ["event", "file", "line", "end_line", "registration", "queued", "dispatches"],
            "additionalProperties": false,
            "properties": {
                "event": {
                    "type": "string",
                    "description": "FQCN for `::class` registrations, the raw string for string-keyed ones."
                },
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File holding the closure, not the registration call."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed first line of the closure."
                },
                "end_line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed last line of the closure; equals `line` for a one-line closure."
                },
                "registration": {
                    "enum": ["listen_array", "event_listen_call", "subscriber", "model_hook"],
                    "description": "`listen_array`: closure in `$listen`.\n`event_listen_call`: second argument of `Event::listen()`.\n`subscriber`: inside a subscriber's `subscribe()`, as a return-array value or an imperative `$events->listen()`.\n`model_hook`: a closure passed to a model's static hook registrar (`static::creating(fn ...)`); `event` is the model event id (`eloquent.{hook}: {model}`)."
                },
                "queued": {
                    "type": "boolean",
                    "description": "Always `false`; closure queue detection is not done."
                },
                "dispatches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatch" },
                    "description": "Dispatches attributed to the closure by source span."
                }
            },
            "description": "Closure and arrow-function registrations, one entry per site, never joined into `events[].handled_by`. Not deduplicated. Dispatches inside `[line, end_line]` of the file belong to it, nested closures included. Filter by `event` to find the closures for an event."
        },
        "scheduleEntry": {
            "type": "object",
            "required": [
                "kind",
                "name",
                "target",
                "arguments",
                "queue",
                "connection",
                "cron",
                "frequency",
                "timezone",
                "without_overlapping",
                "without_overlapping_expires_at",
                "on_one_server",
                "run_in_background",
                "even_in_maintenance_mode",
                "constraints",
                "file",
                "line"
            ],
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "enum": ["command", "job", "closure", "exec"],
                    "description": "`command`: `->command()`; `target` is the signature verbatim, options included, or the FQCN.\n`job`: `->job()`; `target` is the FQCN.\n`closure`: `->call()`; `target` is `null` for an inline closure, else `Class::method` (from `[Cls::class, 'method']` or `'Cls@method'`).\n`exec`: `->exec()`; `target` is the shell string."
                },
                "name": {
                    "type": ["string", "null"],
                    "description": "The `->name()` label verbatim, or `null`."
                },
                "target": {
                    "type": ["string", "null"],
                    "description": "Depends on `kind`; `null` for an inline closure."
                },
                "arguments": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "`command` kind only, else `[]`. The literal parameters of `->command(Class::class, [...])`: plain items as the stringified value, keyed items as `key=value`, booleans as `true`/`false`; unresolvable items are skipped."
                },
                "queue": {
                    "type": ["string", "null"],
                    "description": "`job` kind only: the second argument of `->job($job, $queue)`."
                },
                "connection": {
                    "type": ["string", "null"],
                    "description": "`job` kind only: the third argument of `->job($job, $queue, $connection)`."
                },
                "cron": {
                    "type": ["string", "null"],
                    "description": "Canonical five-field expression for every recognised helper (`daily` is `0 0 * * *`; `cron()` passes through). `null` for an unrecognised helper or a variable argument. The last helper in the chain wins."
                },
                "frequency": {
                    "oneOf": [
                        { "type": "null" },
                        {
                            "type": "object",
                            "required": ["unit", "every"],
                            "additionalProperties": false,
                            "properties": {
                                "unit": {
                                    "enum": ["seconds"],
                                    "description": "Only `seconds` today."
                                },
                                "every": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "description": "Interval length in `unit`."
                                }
                            }
                        }
                    ],
                    "description": "Sub-minute interval for the seven helpers `everySecond` to `everyThirtySeconds`, whose `cron` is `null`; `null` otherwise. At most one of `cron` and `frequency` is set."
                },
                "timezone": {
                    "type": ["string", "null"],
                    "description": "From `->timezone()`."
                },
                "without_overlapping": {
                    "type": "boolean",
                    "description": "`->withoutOverlapping()` appears in the chain."
                },
                "without_overlapping_expires_at": {
                    "type": ["integer", "null"],
                    "description": "Expiry minutes from `->withoutOverlapping($minutes)`. `null` without a literal argument."
                },
                "on_one_server": {
                    "type": "boolean",
                    "description": "`->onOneServer()` appears in the chain."
                },
                "run_in_background": {
                    "type": "boolean",
                    "description": "`->runInBackground()` appears in the chain."
                },
                "even_in_maintenance_mode": {
                    "type": "boolean",
                    "description": "`->evenInMaintenanceMode()` appears in the chain."
                },
                "constraints": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Opaque labels for non-cron restrictions, sorted ascending. They sit beside `cron`, not inside it.\nDay of week: `weekdays`, `sundays`.\nTime window: `between(8:00,17:00)`.\nConditions: `when(closure)`, `skip(closure)`.\nEnvironments: `environments(production,staging)`."
                },
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File of the root call (`->command`, `->job`, `->call`, `->exec`)."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Line of the root call, not the trailing modifier."
                }
            },
            "description": "Scheduler entries, one per chain. Deduplicated on `file`, `line`, `kind`, `target`; kernel and bootstrap forms win over the facade form. Join a `job` target to `jobs[]` client-side."
        },
        "route": {
            "type": "object",
            "required": ["method", "uri", "name", "controller_fqcn", "controller_method", "middleware", "file", "line", "dispatches"],
            "additionalProperties": false,
            "properties": {
                "method": {
                    "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD", "ANY"],
                    "description": "HTTP verb, uppercase."
                },
                "uri": {
                    "type": "string",
                    "description": "Route URI with enclosing group prefixes applied; always starts with `/`, the root is `/`."
                },
                "name": {
                    "type": ["string", "null"],
                    "description": "Group name prefix concatenated as-is with the route's own `->name()`; `null` when unnamed."
                },
                "controller_fqcn": {
                    "type": ["string", "null"],
                    "description": "`null` for closure and non-controller routes."
                },
                "controller_method": {
                    "type": ["string", "null"],
                    "description": "`null` for closure and non-controller routes."
                },
                "middleware": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Names as written, including those inherited from enclosing groups. Aliases and groups are not expanded. Source order."
                },
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File of the route definition."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed line of the route definition."
                },
                "end_line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Last line of a closure action. Present only for closure actions."
                },
                "dispatches": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatch" },
                    "description": "From the controller method, or for a closure route the dispatches within `[line, end_line]` of the file. Empty when the controller cannot be resolved. Each dispatched event also lists the route in its `dispatched_from`."
                }
            },
            "description": "HTTP routes, one per route. A route registered against several verbs is reported as `ANY`."
        },
        "mailable": {
            "type": "object",
            "required": ["fqcn", "file", "line", "queued", "queue_config", "sent_from"],
            "additionalProperties": false,
            "properties": {
                "fqcn": {
                    "type": "string",
                    "description": "Fully qualified class name."
                },
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File declaring the class."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed declaration line."
                },
                "queued": {
                    "type": "boolean",
                    "description": "`true` when the class implements `ShouldQueue` directly or through a parent class or interface."
                },
                "queue_config": {
                    "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/queueConfig" }],
                    "description": "`null` when `queued` is `false`."
                },
                "sent_from": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatchSite" },
                    "description": "Dispatch sites whose resolved kind is `mailable` and whose target is this class, sorted by `file`, `line`."
                }
            },
            "description": "Mailable classes."
        },
        "notification": {
            "type": "object",
            "required": ["fqcn", "file", "line", "queued", "queue_config", "notified_from", "channels", "channels_dynamic"],
            "additionalProperties": false,
            "properties": {
                "fqcn": {
                    "type": "string",
                    "description": "Fully qualified class name."
                },
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File declaring the class."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed declaration line."
                },
                "queued": {
                    "type": "boolean",
                    "description": "`true` when the class implements `ShouldQueue` directly or through a parent class or interface."
                },
                "queue_config": {
                    "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/queueConfig" }],
                    "description": "`null` when `queued` is `false`."
                },
                "notified_from": {
                    "type": "array",
                    "items": { "$ref": "#/$defs/dispatchSite" },
                    "description": "Dispatch sites whose resolved kind is `notification` and whose target is this class, sorted by `file`, `line`. The only list whose entries may carry `channels`."
                },
                "channels": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "From a `via()` that is a single `return [...]` of literal strings (lowercased) or `Class::class` constants (FQCN), in source order. `[]` when `via()` is dynamic, not declared or inherited."
                },
                "channels_dynamic": {
                    "type": "boolean",
                    "description": "`true` only when `via()` exists but is not a single literal-array return; the channels exist but cannot be read statically."
                }
            },
            "description": "Notification classes."
        },
        "unresolvedDispatch": {
            "type": "object",
            "required": ["file", "line", "expression", "reason"],
            "additionalProperties": false,
            "properties": {
                "file": {
                    "$ref": "#/$defs/relativePath",
                    "description": "File containing the unresolved dispatch."
                },
                "line": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "1-indexed line of the unresolved dispatch."
                },
                "expression": {
                    "type": "string",
                    "description": "Pretty-printed source of the unresolvable expression."
                },
                "reason": {
                    "enum": ["dynamic_class_name", "container_resolution", "string_concatenation", "conditional_dispatch", "unreadable_listener", "unreadable_model_hook"],
                    "description": "`dynamic_class_name`: a variable.\n`container_resolution`: `app()`, `resolve()`, `->make()`.\n`string_concatenation`: concatenation or interpolation.\n`conditional_dispatch`: a ternary whose branches cannot be evaluated.\n`unreadable_listener`: a listener registration (`$listen`, `Event::listen()`, `Event::subscribe()`) whose event or handler is not a readable literal.\n`unreadable_model_hook`: a `static::creating(...)` style hook whose callback is not a closure or readable callable."
                }
            },
            "description": "Dispatch sites and listener or model-hook registrations that could not be resolved statically. Never dropped silently."
        }
    }
}
