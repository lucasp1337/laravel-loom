{
    "name": "lucasp1337/laravel-loom",
    "description": "Static architectural inspector for Laravel applications — emits a JSON index of events, listeners, and observers.",
    "keywords": ["laravel", "static-analysis", "events", "listeners", "observers", "loom"],
    "homepage": "https://github.com/lucasp1337/laravel-loom",
    "license": "MIT",
    "authors": [
        {
            "name": "Lucas Palka",
            "email": "lucaspalkabusiness@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "justinrainbow/json-schema": "^6.0",
        "laravel/mcp": "^0.8.1",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.14",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0",
        "pestphp/pest-plugin-arch": "^3.0",
        "phpstan/extension-installer": "^1.4"
    },
    "autoload": {
        "psr-4": {
            "Lucasp\\Loom\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lucasp\\Loom\\Tests\\": "tests/",
            "Lucasp\\Loom\\Benchmarks\\": "benchmarks/src/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "bench": "php benchmarks/bench.php",
        "bench:assert": "php benchmarks/bench.php --assert",
        "bench:baseline": "php benchmarks/bench.php --baseline"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lucasp\\Loom\\LoomServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
