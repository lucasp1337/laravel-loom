parameters:
    level: 8
    paths:
        - src
        - benchmarks/src
        - benchmarks/bench.php
    tmpDir: build/phpstan
    # Pin to a single process: PHPStan's default parallel workers deadlock under
    # the Docker-on-WSL2 toolchain and hang with no output. Single-process keeps
    # `just check` / `vendor/bin/phpstan analyse` safe without needing --debug.
    parallel:
        maximumNumberOfProcesses: 1
    ignoreErrors:
        # Larastan's view-string type only admits views it can find on disk; it
        # cannot resolve views in this package's own `loom::` namespace.
        -
            message: '#expects view-string, string given#'
            identifier: argument.type
            path: src/Ui/Livewire/*
